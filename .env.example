# Server-side only. Start with: python3 -m backend.server
ROOM_HOST=127.0.0.1
ROOM_PORT=8787
# Optional: enable real MuJoCo reruns from the original project.
# SIM_SOURCE=/absolute/path/to/robot-incident-analyst
# SIM_PYTHON=/absolute/path/to/robot-incident-analyst/.venv/bin/python
# Optional OpenAI-compatible inference endpoint. Coshell build credits are
# configured in Coshell; do not assume they provide an inference API here.
# ROOM_LLM_BASE_URL=https://your-provider.example/v1
# ROOM_LLM_API_KEY=
# ROOM_LLM_MODEL=
